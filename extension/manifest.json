{
  "manifest_version": 3,
  "name": "Setu Bridge",
  "version": "1.0",
  "description": "Setu bridge for Gemini chat",
  "host_permissions": [
    "*://127.0.0.1/*",
    "*://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"]
    }
  ]
}
